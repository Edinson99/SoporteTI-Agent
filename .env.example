# Copia este archivo como .env y completa solo valores locales.
# Nunca subas una clave real al repositorio.
API_KEY=
MODEL_NAME=mock

# Busqueda semantica local, opcional (true/false; por defecto false).
# Requiere instalar requirements-semantic.txt; el modelo se descarga una vez.
# Las consultas y la base de conocimiento se procesan localmente.
# SOPORTE_SEMANTIC_SEARCH=false

# Limite en memoria por ruta y origen de conexion (por defecto 60 por minuto).
# No se guarda IP ni contenido de solicitudes.
# SOPORTE_RATE_LIMIT_PER_MINUTE=60

# Errores opcionales con Sentry. Los eventos se filtran para quitar solicitudes,
# mensajes, datos personales, variables locales y secretos antes del envio.
# Instala requirements-observability.txt.
# SENTRY_DSN=

# Correo principal de tickets con Gmail API; puede usar Resend como respaldo.
# Reutiliza la firma configurada en Gmail para el proveedor principal.
GMAIL_SENDER=
GMAIL_TO_EMAIL=
GMAIL_OAUTH_CLIENT_SECRETS=.secrets/gmail-oauth-client.json
GMAIL_OAUTH_TOKEN_FILE=.secrets/gmail-token.json
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO_EMAIL=

# Slack recibe solo numero, prioridad y categoria de tickets high/critical.
# SLACK_WEBHOOK_URL=

# Canal MTProto opcional para cuenta personal. Instala
# requirements-telegram-mtproto.txt y ejecuta -m scripts.telegram_mtproto.
# La primera ejecucion solicita el telefono, codigo y, si aplica, la clave 2FA
# directamente en la consola. La sesion se guarda en .secrets/ (no compartir).
# Regenera api_hash si fue compartido y limita el acceso a IDs de usuario.
# TELEGRAM_MTPROTO_API_ID=
# TELEGRAM_MTPROTO_API_HASH=
# TELEGRAM_MTPROTO_ALLOWED_USER_IDS=123456789,987654321

# Alternativa legacy: webhook Telegram Bot API para bot de BotFather.
# Configura el webhook HTTPS con TELEGRAM_WEBHOOK_SECRET como secret_token.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# Base SQLite local de tickets (opcional; por defecto data/tickets.sqlite3).
# SOPORTE_TICKETS_DB=

# Valoraciones anonimas de guias (por defecto data/feedback.sqlite3).
# Guarda id de guia, valoracion y fecha UTC por un maximo de 180 dias.
# SOPORTE_FEEDBACK_DB=

# Persistencia: sqlite (predeterminado) o firebase (Data Connect).
# Para Firebase requiere ADC local o credenciales de workload identity en el servidor.
# SOPORTE_TICKETS_BACKEND=sqlite
# FIREBASE_PROJECT_ID=soporteit-tickets
# DATA_CONNECT_SERVICE_ID=soporteit-tickets-service
# DATA_CONNECT_LOCATION=us-east4
# NODE_BIN=
