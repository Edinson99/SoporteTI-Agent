# Copia este archivo como .env y completa solo valores locales.
# Nunca subas una clave real al repositorio.
API_KEY=
MODEL_NAME=mock

# Notificacion de tickets sin guia mediante Gmail SMTP.
# Crea una contrasena de aplicacion en Google y guardala solo en este .env local.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=soporteitelectiva@gmail.com
SMTP_FROM_EMAIL=soporteitelectiva@gmail.com
SMTP_TO_EMAIL=javiercito9456@gmail.com
SMTP_APP_PASSWORD=

# Base SQLite local de tickets (opcional; por defecto data/tickets.sqlite3).
# SOPORTE_TICKETS_DB=

# Persistencia: sqlite (predeterminado) o firebase (Data Connect).
# Para Firebase requiere ADC local o credenciales de workload identity en el servidor.
# SOPORTE_TICKETS_BACKEND=sqlite
# FIREBASE_PROJECT_ID=soporteit-tickets
# DATA_CONNECT_SERVICE_ID=soporteit-tickets-service
# DATA_CONNECT_LOCATION=us-east4
# NODE_BIN=
